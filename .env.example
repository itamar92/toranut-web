# Service Account (אותו אחד מ-Platoon-web)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"

# הגיליון — יוצרים ריק ב-Google Sheets, משתפים עם ה-Service Account כעורך, ומדביקים את ה-id מה-URL
SHEET_ID=

# כניסה עם Google: OAuth 2.0 Client ID מסוג Web Application, מאותו פרויקט Google Cloud.
# Authorized JavaScript origins: כתובת ה-Vercel + http://localhost:8787
GOOGLE_CLIENT_ID=

# כניסה בקוד (גיבוי): קוד הצ׳יף. קודי הרופאים נשמרים מגובבים בטבלת doctors
CHIEF_CODE=
SESSION_SECRET=
SESSION_DAYS=60

# התראות לטלפון (Web Push): npm run push keys — פעם אחת. החלפה מנתקת את כל המכשירים שהפעילו התראות.
# VAPID_SUBJECT אופציונלי (mailto: או https:); ברירת המחדל — כתובת האתר
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# תזכורות אוטומטיות (api/cron.js) — POST עם CRON_SECRET מטריגר חיצוני
CRON_SECRET=
TZ=Asia/Jerusalem
